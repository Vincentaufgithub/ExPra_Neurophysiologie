## data preparation ####
data2 <- read.csv("FoPra_Exp2.csv", header=TRUE)

# convert to categorical
data2$timing <- factor(data2$timing, levels = c("start", "end"))
data2$sensilla <- factor(data2$sensilla)
data2$trial_id <- factor(data2$trial_id)


## Poisson model ####
m2_poisson <- glmer(
  n_spikes ~ timing + (1 | sensilla) + (1 | trial_id),
  data   = data2,
  family = poisson(link = "log")
)

overdisp_fun(m2_poisson)
# -> significantly overdispersed
summary(m2_poisson) # just to see the degrees of freedom


## negative-binomial model ####
m2_nb <- glmer.nb(
  n_spikes ~ timing + (1 | sensilla) + (1 | trial_id),
  data = data2,
  control = glmerControl(optimizer = "bobyqa")
)

overdisp_fun(m2_nb) # fits well
summary(m2_nb)

# confidence intervals
ci_matrix <- confint(m2_nb, parm = "beta_", method = "Wald")
cis <- cbind(Estimate = fixef(m2_nb), ci_matrix)
exp(cis)



## plotting ####

# access the model's prediction easily
model_preds <- emmeans(m2_nb, ~ timing, type = "response") %>% 
  as.data.frame()


# colour-blind friendly colour palette
okabe_ito <- c(
  "#E69F00", # Orange
  "#56B4E9", # Sky Blue
  "#009E73", # Bluish Green
  "#F0E442", # Yellow
  "#CC79A7" # Reddish Purple
)

exp2_nbplot <- ggplot() +
  # Raw individual trial trajectories (faint lines color-coded by sensillum)
  geom_line(
    data = data2,
    aes(x = timing, y = n_spikes, group = interaction(sensilla, trial_id), color = sensilla),
    alpha = 0.35, linewidth = 0.7
  ) +
  geom_point(
    data = data2,
    aes(x = timing, y = n_spikes, color = sensilla),
    alpha = 0.5, size = 1.2
  ) +
  
  # GLM Population Estimate + 95% CI from emmeans
  geom_errorbar(
    data = model_preds,
    aes(x = timing, ymin = asymp.LCL, ymax = asymp.UCL),
    width = 0.08, size = 0.9, color = "black"
  ) +
  geom_line(
    data = model_preds,
    aes(x = timing, y = response, group = 1),
    color = "black", size = 1.3
  ) +
  geom_point(
    data = model_preds,
    aes(x = timing, y = response),
    color = "black", fill = "white", shape = 21, size = 4, stroke = 1.5
  ) +
  
  # Aesthetics
  scale_color_manual(values = okabe_ito, name = "Sensillum") +
  
  scale_x_discrete(labels = c("start" = "First Second", "end" = "Last Second")) +
  labs(
    x = "Stimulation Window",
    y = "Spike Count"
  ) +
  
  theme_classic(base_size = 14) +
  theme(legend.position = c(0.9, 0.95),
        legend.justification = c("right", "top"),
        legend.background = element_rect(color = "black", linewidth = 0.5, fill = "transparent"),
        legend.text = element_text(family = "sans", size = 10))

print(exp2_nbplot)

### save ####
ggplot2::ggsave("exp2_nbplot.png", plot = exp2_nbplot,
                width = 8, height = 5, dpi = 600)


