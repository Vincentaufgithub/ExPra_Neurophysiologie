source(file = "glmm_funs.R")



#___________________
# Experiment 1 ####
#___________________
#___________________

data1 <- read.csv("FoPra_Exp1.csv", header=TRUE)


## visualization ####
#___________________

exp1_loessplot <- ggplot(data1, aes(x = airflow, y = n_spikes)) +
  geom_jitter(color = "black", alpha = 0.3, size = 1.5,
              shape = 16, width = 0.02) +
  geom_smooth(method = "loess", se = FALSE, colour = "#0068d6") +
  theme_minimal() +
  theme_classic() +
  labs(
    x = "Airflow strength (m³/h)",
    y = "Spikes per second",
  )

ggplot2::ggsave("exp1_loessplot.png", plot = exp1_loessplot,
                width = 8, height = 4, dpi = 600)


## Poisson regression ####
#___________________

m1_poisson <- glm(n_spikes ~ airflow, family = "poisson", data = data1)

# test assumptions
with(m1_poisson, cbind(res.deviance = deviance, df = df.residual,
               p = pchisq(deviance, df.residual, lower.tail=FALSE)))

# model assumptions are broken. A Poisson model is not ideal.


## negative-binomial regression ####
#___________________

m1_nb <- glm.nb(n_spikes ~ airflow, data = data1)

# test model fit
with(m1_nb, cbind(res.deviance = deviance, df = df.residual,
               p = pchisq(deviance, df.residual, lower.tail=FALSE)))
# not significant (model is appropriate)

# model result
summary(m1_nb)

# 95% confidence intervals
cis <- cbind(Estimate = coef(m1_nb), confint(m1_nb))

# exponentiate for intuitice interpretation
exp(cis)


## Plot ####
#___________________

### preparation ####

# a few steps to fit the predicted values on the graph
# construct x-scale to plot the regression on (from 0.1 to 1.0, plus some margins)
newdat <- data.frame(
  airflow = seq(min(data1$airflow) - 0.03, # add small margins to end and beginning 
                max(data1$airflow) + 0.03, # so it looks nicer with the scattering
                length.out = 200))

# predicted values for the airflow range
pred <- predict(m1_nb, newdata = newdat,
                type = "link", se.fit = TRUE)

# extract predicted values and confidence band
newdat$fit <- exp(pred$fit)
newdat$lwr <- exp(pred$fit - 1.96 * pred$se.fit)
newdat$upr <- exp(pred$fit + 1.96 * pred$se.fit)

### Plot ####

exp1_nbplot <- ggplot(data1, aes(x = airflow, y = n_spikes)) +
  
  # individual data points (jittered)
  geom_jitter(color = "black", alpha = 0.3, size = 1.5,
              shape = 16, width = 0.03, height = 0) +
  
  # means for each airflow level
  stat_summary(fun = mean,
               geom = "point",
               size = 2,
               colour = "black") +
  
  # regression slope
  geom_line(data = newdat,
            aes(y = fit, x = airflow),
            linewidth = 1,
            colour = "#0068d6") +
  
  # confidence band
  geom_ribbon(data = newdat,
              aes(x = airflow, y = NULL, ymin = lwr, ymax = upr),
              alpha = 0.2,
              fill = "#9cbaea") +
  
  # visuals
  labs(
    x = "Airflow strength (m³/h)",
    y = "Number of spikes",
  ) +
  theme_classic()

print(exp1_nbplot)
### save ####
ggplot2::ggsave("exp1_nbplot.png", plot = exp1_nbplot,
                width = 8, height = 5, dpi = 600)



